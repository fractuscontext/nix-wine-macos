{
  "editor.formatOnSave": true,
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide"
  },
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": [
          "nixfmt"
        ]
      }
    }
  },
  // Python (using charliermarsh.ruff)
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "python.analysis.typeCheckingMode": "basic",
  // Shell/Bash (using foxundermoon.shell-format)
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "shellformat.flag": "-i 2 -s",
  // TOML (using tamasfe.even-better-toml which uses taplo)
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  // C/C++ (using llvm-vs-code-extensions.vscode-clangd)
  "[cpp][c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "clangd.arguments": [
    "--fallback-style=Google"
  ],
  "[swift]": {
    "editor.defaultFormatter": "swiftlang.swift-vscode"
  },
  "[json][jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "ansible.validation.lint.enabled": true,
  "ansible.validation.lint.path": "ansible-lint",
  "markdownlint.run": "onType",
  "css.validate": true,
  "html.validate.scripts": true,
  "html.validate.styles": true,
  "json.validate.enable": true,
  "yaml.format.enable": true,
  "yaml.disableSchemaDetection": [],
  "files.trimTrailingWhitespace": true
}